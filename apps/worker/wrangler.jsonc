{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinto",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinto-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "BETTER_AUTH_URL": "https://pintoclimb.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pinto-db-production",
          "database_id": "e45211fc-950a-43d0-97b9-d7634771f5a3",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}

{
  "name": "@pinto/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.pinto.config.ts",
    "build": "vite build --config vite.pinto.config.ts",
    "typecheck": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict --skipLibCheck --jsx react-jsx --lib ES2022,DOM,DOM.Iterable --types vite/client src/main.tsx",
    "test": "vitest run --config vite.pinto.config.ts",
    "test:watch": "vitest --config vite.pinto.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@pinto/shared": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "idb": "^8.0.4",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
